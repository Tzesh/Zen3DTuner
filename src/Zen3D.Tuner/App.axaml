<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Zen3D.Tuner.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#54DFC3" />
    <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="#54DFC3" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme><FluentTheme.Palettes><ColorPaletteResources x:Key="Dark" Accent="#54DFC3" /></FluentTheme.Palettes></FluentTheme>
  </Application.Styles>
</Application>

